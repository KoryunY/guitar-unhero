{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:guitar-unhero:score:v1",
  "title": "Guitar Unhero score v1 — monophonic standard-tuning subset",
  "description": "Initial interchange contract. Semantic validation is additionally required for pitch/fret consistency, bounds, order, unique IDs, non-overlap, rights policy, and alignment monotonicity. Unknown properties and unsupported features are rejected rather than discarded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "arrangementId", "version", "parent", "title", "role", "ppq", "durationTicks", "instrument", "tempoMap", "meterMap", "events", "rights", "provenance", "transformations"],
  "properties": {
    "schemaVersion": {"const": "gu-score/1"},
    "arrangementId": {"$ref": "#/$defs/id"},
    "version": {"type": "integer", "minimum": 1},
    "parent": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["arrangementId", "version"],
          "properties": {
            "arrangementId": {"$ref": "#/$defs/id"},
            "version": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "role": {"enum": ["original_exercise", "transcription_candidate", "reviewed_part", "simplified_arrangement"]},
    "ppq": {"const": 960},
    "durationTicks": {"type": "integer", "minimum": 1, "maximum": 10000000},
    "instrument": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "capo", "maxFret", "strings"],
      "properties": {
        "type": {"const": "six_string_guitar"},
        "capo": {"const": 0, "description": "Full/partial capo and tuning changes require a later explicitly supported contract."},
        "maxFret": {"type": "integer", "minimum": 3, "maximum": 24},
        "strings": {
          "description": "String numbering is high-to-low; these are sounding open-string MIDI pitches.",
          "const": [
            {"number": 1, "openMidi": 64},
            {"number": 2, "openMidi": 59},
            {"number": 3, "openMidi": 55},
            {"number": 4, "openMidi": 50},
            {"number": 5, "openMidi": 45},
            {"number": 6, "openMidi": 40}
          ]
        }
      }
    },
    "tempoMap": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["tick", "bpm"],
        "properties": {"tick": {"const": 0}, "bpm": {"type": "number", "minimum": 20, "maximum": 300}}
      }
    },
    "meterMap": {
      "const": [{"tick": 0, "numerator": 4, "denominator": 4}]
    },
    "events": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {"$ref": "#/$defs/noteEvent"}
    },
    "rights": {"$ref": "#/$defs/rights"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["createdAt", "createdBy", "method", "reviewStatus", "reviewer"],
      "properties": {
        "createdAt": {"type": "string", "format": "date-time"},
        "createdBy": {"type": "string", "minLength": 1, "maxLength": 200},
        "method": {"enum": ["authored", "imported", "model_candidate", "derived"]},
        "reviewStatus": {"enum": ["unreviewed", "user_reviewed", "teacher_reviewed"]},
        "reviewer": {"type": ["string", "null"], "maxLength": 200},
        "providerId": {"type": ["string", "null"], "maxLength": 200},
        "providerVersion": {"type": ["string", "null"], "maxLength": 200},
        "modelArtifactSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "notes": {"type": "string", "maxLength": 4000}
      }
    },
    "transformations": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "description", "sourceEventIds", "resultEventIds"],
        "properties": {
          "kind": {"enum": ["omit", "rhythm_simplify", "octave_shift", "transpose", "fingering_change", "manual_edit", "select_part"]},
          "description": {"type": "string", "minLength": 1, "maxLength": 1000},
          "sourceEventIds": {"$ref": "#/$defs/idList"},
          "resultEventIds": {"$ref": "#/$defs/idList"}
        }
      }
    },
    "sourceAudio": {
      "type": "object", "additionalProperties": false,
      "required": ["assetId", "sha256", "durationSec", "rights", "alignmentStatus", "anchors"],
      "properties": {
        "assetId": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "durationSec": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
        "rights": {"$ref": "#/$defs/rights"},
        "alignmentStatus": {"enum": ["candidate", "user_reviewed", "teacher_reviewed"]},
        "anchors": {
          "type": "array", "minItems": 2, "maxItems": 10000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["tick", "sourceSec"],
            "properties": {
              "tick": {"type": "integer", "minimum": 0},
              "sourceSec": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "idList": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "noteEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "startTick", "durationTicks", "pitchMidi", "string", "fret", "finger", "sourceEventIds", "assessment"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "note"},
        "startTick": {"type": "integer", "minimum": 0},
        "durationTicks": {"type": "integer", "minimum": 1},
        "pitchMidi": {"type": "integer", "minimum": 40, "maximum": 88},
        "string": {"type": "integer", "minimum": 1, "maximum": 6},
        "fret": {"type": "integer", "minimum": 0, "maximum": 24},
        "finger": {"enum": [null, 1, 2, 3, 4]},
        "sourceEventIds": {"$ref": "#/$defs/idList"},
        "assessment": {
          "type": "object", "additionalProperties": false,
          "required": ["pitch", "attack", "sustain"],
          "properties": {"pitch": {"type": "boolean"}, "attack": {"type": "boolean"}, "sustain": {"const": false}}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"fret": {"const": 0}}, "required": ["fret"]},
          "then": {"properties": {"finger": {"type": "null"}}}
        }
      ]
    },
    "rights": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "author", "license", "allowedUses", "sourceUri", "evidence"],
      "properties": {
        "status": {"enum": ["unknown", "user_declared", "verified", "restricted"]},
        "author": {"type": ["string", "null"], "maxLength": 500},
        "license": {"type": ["string", "null"], "maxLength": 500},
        "allowedUses": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["local_practice", "private_hosted_analysis", "modify", "redistribute"]}
        },
        "sourceUri": {"type": ["string", "null"], "maxLength": 2000},
        "evidence": {"type": ["string", "null"], "maxLength": 4000}
      }
    }
  }
}
