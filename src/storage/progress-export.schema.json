{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:guitar-unhero:progress-export:v1",
  "title": "Guitar Unhero local progress export v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "exportedAt",
    "app",
    "settings",
    "lessons",
    "summaries"
  ],
  "properties": {
    "format": {
      "const": "guitar-unhero-progress"
    },
    "formatVersion": {
      "const": 1
    },
    "exportedAt": {
      "type": "string",
      "maxLength": 40
    },
    "app": {
      "type": "string",
      "maxLength": 100
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "handedness": {
          "enum": [
            "right",
            "left"
          ]
        },
        "hasGuitar": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "inputMode": {
          "enum": [
            "microphone",
            "simulation",
            "none"
          ]
        },
        "deviceId": {
          "type": "null"
        },
        "outputRoute": {
          "enum": [
            "headphones",
            "speakers",
            "unknown"
          ]
        },
        "reducedMotion": {
          "enum": [
            "system",
            "on",
            "off"
          ]
        },
        "stageEffects": {
          "type": "boolean"
        },
        "highContrast": {
          "type": "boolean"
        },
        "guideLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metronomeLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "referenceLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "practiceRate": {
          "enum": [
            0.5,
            0.75,
            1
          ]
        },
        "practiceMode": {
          "enum": [
            "listen",
            "fixed",
            "wait"
          ]
        },
        "guideOn": {
          "type": "boolean"
        },
        "metronomeOn": {
          "type": "boolean"
        },
        "lookaheadSec": {
          "type": "number",
          "minimum": 1,
          "maximum": 6
        },
        "onboarded": {
          "type": "boolean"
        },
        "calibration": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "offsetMs",
                "spreadMs",
                "samples",
                "deviceId",
                "sampleRate",
                "outputRoute",
                "createdAt"
              ],
              "properties": {
                "method": {
                  "enum": [
                    "loopback",
                    "manual"
                  ]
                },
                "offsetMs": {
                  "type": "number",
                  "minimum": -500,
                  "maximum": 1000
                },
                "spreadMs": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1000
                },
                "samples": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "deviceId": {
                  "type": "null"
                },
                "sampleRate": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "outputRoute": {
                  "enum": [
                    "headphones",
                    "speakers",
                    "unknown"
                  ]
                },
                "createdAt": {
                  "type": "string",
                  "maxLength": 40
                },
                "outputLatencyMs": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 2000
                }
              }
            }
          ]
        },
        "advanced": {
          "type": "boolean"
        },
        "cameraLab": {
          "type": "boolean"
        },
        "theme": {
          "enum": [
            "system",
            "light",
            "stage"
          ]
        },
        "voice": {
          "enum": [
            "plain",
            "funny",
            "metal"
          ]
        },
        "instrument": {
          "enum": [
            "acoustic",
            "electric",
            "classical"
          ]
        },
        "tuning": {
          "enum": [
            "standard",
            "drop_d",
            "half_step_down",
            "d_standard",
            "open_g",
            "open_d",
            "dadgad"
          ]
        }
      }
    },
    "lessons": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lessonId",
          "lessonVersion",
          "completedSteps",
          "completedAt",
          "completionEvidence",
          "skillState"
        ],
        "properties": {
          "lessonId": {
            "type": "string",
            "maxLength": 120
          },
          "lessonVersion": {
            "type": "integer",
            "minimum": 1
          },
          "completedSteps": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stepId",
                "evidence",
                "at"
              ],
              "properties": {
                "stepId": {
                  "type": "string",
                  "maxLength": 120
                },
                "evidence": {
                  "enum": [
                    "sensor",
                    "self_reported",
                    "simulated"
                  ]
                },
                "at": {
                  "type": "string",
                  "maxLength": 40
                }
              }
            }
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "completionEvidence": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "sensor",
                  "self_reported",
                  "simulated"
                ]
              }
            ]
          },
          "skillState": {
            "enum": [
              "unseen",
              "introduced",
              "practicing",
              "demonstrated",
              "retained"
            ]
          },
          "imported": {
            "type": "boolean"
          },
          "retainedAt": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          }
        }
      }
    },
    "summaries": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "arrangementId",
          "arrangementVersion",
          "title",
          "mode",
          "rate",
          "loop",
          "inputSource",
          "simulated",
          "calibrated",
          "policyVersion",
          "stats",
          "suggestion",
          "startedAt",
          "finishedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 120
          },
          "arrangementId": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "arrangementVersion": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "mode": {
            "enum": [
              "listen",
              "fixed",
              "wait"
            ]
          },
          "rate": {
            "enum": [
              0.5,
              0.75,
              1
            ]
          },
          "loop": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "aTick",
                  "bTick"
                ],
                "properties": {
                  "aTick": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "bTick": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            ]
          },
          "inputSource": {
            "enum": [
              "microphone",
              "simulation",
              "none"
            ]
          },
          "simulated": {
            "type": "boolean"
          },
          "calibrated": {
            "type": "boolean"
          },
          "policyVersion": {
            "type": "string",
            "maxLength": 40
          },
          "suggestion": {
            "type": "string",
            "maxLength": 2000
          },
          "startedAt": {
            "type": "string",
            "maxLength": 40
          },
          "finishedAt": {
            "type": "string",
            "maxLength": 40
          },
          "imported": {
            "type": "boolean"
          },
          "stats": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "eligible",
              "assessable",
              "coverage",
              "pitch",
              "timing",
              "states",
              "missed",
              "wrongPitch"
            ],
            "properties": {
              "eligible": {
                "type": "integer",
                "minimum": 0
              },
              "assessable": {
                "type": "integer",
                "minimum": 0
              },
              "coverage": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "pitch": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "correct",
                  "assessed",
                  "accuracy"
                ],
                "properties": {
                  "correct": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "assessed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "accuracy": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "timing": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "correct",
                  "assessed",
                  "accuracy",
                  "meanErrorMs",
                  "approximate",
                  "enabled"
                ],
                "properties": {
                  "correct": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "assessed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "accuracy": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "meanErrorMs": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "approximate": {
                    "type": "boolean"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                }
              },
              "states": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "correct",
                  "incorrect",
                  "uncertain",
                  "not_assessed"
                ],
                "properties": {
                  "correct": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "incorrect": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "uncertain": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "not_assessed": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "missed": {
                "type": "integer",
                "minimum": 0
              },
              "wrongPitch": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "cueLevel": {
            "enum": [
              "full",
              "reduced",
              "none"
            ]
          }
        }
      }
    }
  }
}
